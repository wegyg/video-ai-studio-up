# ShortsDirector runs FULLY without any of these. They are optional upgrades.
# Copy to .env and fill only what you want. Empty = free/local behavior.
# (Google APIs are intentionally NOT used anywhere.)

# --- Plan generation: the AI "director" ---
# Free default = built-in template director (7-beat CF structure, no API).
# Add a key to use an LLM for tailored copy. Card-free, OpenAI-compatible:
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<a free model>
#   Cerebras    LLM_BASE_URL=https://api.cerebras.ai/v1       LLM_MODEL=llama3.1-70b
# On any error or missing key it falls back to the template — never breaks.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Narration voice (TTS) ---
# Free default = SILENT narration track (keeps timing; captions + music only).
# Add an OpenAI-compatible /audio/speech key for spoken narration.
TTS_API_KEY=
TTS_BASE_URL=          # default https://api.openai.com/v1
TTS_MODEL=             # default gpt-4o-mini-tts
TTS_VOICE=             # default alloy

# --- Background music ---
# On by default: uses a file from assets/music/ if present, else a procedurally
# synthesized tone-aware bed (FFmpeg, no files). Set to false to disable.
MUSIC_ENABLED=true

# --- Rendering defaults ---
RATIO=9:16             # 9:16 | 1:1 | 16:9
DURATION_SEC=20
FPS=30

# Where job working files + outputs are written (default: OS temp dir).
# SD_WORK_DIR=/var/data/shorts-director
