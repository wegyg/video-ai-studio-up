# ShortsDirector runs fully WITHOUT any of these. They are optional upgrades.
# Copy to .env and fill only what you want. Empty = free/local behavior.

# --- Plan generation (the "director") ---
# Free default = built-in template director. Add a key to use an LLM instead.
# Card-free options (no Google): Groq, OpenRouter, Cerebras (OpenAI-compatible).
LLM_API_KEY=
LLM_BASE_URL=          # e.g. https://api.groq.com/openai/v1
LLM_MODEL=             # e.g. llama-3.3-70b-versatile

# --- Speech-to-text (transcribe uploaded footage) ---
# Free default = skipped (captions come from the plan, not the audio).
STT_API_KEY=

# --- Narration voice (TTS) ---
# Free default = no spoken narration (captions + music only).
TTS_API_KEY=
TTS_VOICE=

# --- Rendering defaults ---
RATIO=9:16             # 9:16 | 1:1 | 16:9
DURATION_SEC=20
FPS=30
