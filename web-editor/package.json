{
  "name": "web-editor",
  "private": true,
  "version": "0.1.0",
  "description": "브라우저 기반 캡컷형 영상 편집기 (정적 웹앱, WebCodecs + Mediabunny)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node tests/scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mediabunny/aac-encoder": "1.60.0",
    "idb": "8.0.3",
    "mediabunny": "1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zundo": "2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "pretendard": "1.3.9",
    "rolldown": "1.2.11",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
