{
  "name": "shorts-director",
  "version": "0.1.0",
  "private": true,
  "description": "Video + one-line brief -> AI edit-plan JSON -> validated -> rendered vertical short (Remotion + FFmpeg). Runs as a web app or a desktop app.",
  "author": "ShortsDirector",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts",
    "plan:sample": "tsx scripts/render-sample.ts",
    "typecheck": "tsc --noEmit",
    "electron:dev": "next build && electron .",
    "electron:start": "electron .",
    "dist": "next build && electron-builder --publish never",
    "dist:win": "next build && electron-builder --win --publish never",
    "dist:mac": "next build && electron-builder --mac --publish never",
    "dist:linux": "next build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.290",
    "@remotion/cli": "4.0.290",
    "@remotion/renderer": "4.0.290",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "32.2.0",
    "electron-builder": "25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  },
  "build": {
    "appId": "com.shortsdirector.app",
    "productName": "ShortsDirector",
    "asar": false,
    "files": [
      "electron/**",
      ".next/**",
      "public/**",
      "remotion/**",
      "src/**",
      "node_modules/**",
      "next.config.mjs",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ShortsDirector-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShortsDirector",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "ShortsDirector",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  }
}
